# ConnectHub configuration.
#
# Copy to .env for local `netlify dev`, and set the same values in
# Netlify → Site settings → Environment variables for the deploy.
#
# ⚠ Only VITE_-prefixed values are safe: those are compiled into the JavaScript
#   every visitor downloads. Everything below the line stays on the server.
#   Never add a VITE_ prefix to a secret.

# ── Safe in the browser ────────────────────────────────────────────────────
# The publishable key reaches nothing on its own: no policies are granted to
# anonymous users, so a session is required for every read and write.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxx

# ── Server only ────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co

# Ignores row-level security entirely. Used only by the admin-action function.
SUPABASE_SERVICE_ROLE_KEY=

# NOTE: there is no STAFF_CODE any more. Each staffer has their own code
# ("Connie-88"), stored per person in the ctd_staff_codes table and managed
# from the Team screen while signed in as an admin. See supabase/ctd-staff-codes.sql.

# The shared Supabase user the staff code is exchanged for. Create it under
# Authentication → Users → Add user (auto-confirm). Nobody types these.
STAFF_AUTH_EMAIL=staff@connecthub.internal
STAFF_AUTH_PASSWORD=

# Approving, deleting and roster changes. Separate from the staff code.
ADMIN_PASSWORD=

# Signs the short-lived admin tokens. Any long random string; changing it
# immediately invalidates every admin session.
ADMIN_TOKEN_SECRET=

# The live site, e.g. https://chapelle-connecthub.netlify.app
APP_URL=

# ── Approval emails ────────────────────────────────────────────────────────
# Sent when someone presses Connect the Dots. All three have to be set or the
# function quietly does nothing — a missing mail setup must never make a
# staffer think their project failed to submit.
#
# NOTIFY_GMAIL_APP_PASSWORD is a Google App Password, not the account's own
# password: myaccount.google.com/apppasswords (needs 2-Step Verification on).
NOTIFY_GMAIL_USER=
NOTIFY_GMAIL_APP_PASSWORD=

# Who hears about it. The approver's address — commas separate several.
NOTIFY_TO=cdantagnan@archbishopchapelle.org
